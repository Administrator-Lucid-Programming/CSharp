        [Theory]
        [MemberData(nameof(ConvertToBase64StringTests_TestData))]
        public static void ConvertToBase64String(byte[] inputBytes, string expectedBase64)
            Assert.Equal(expectedBase64, Convert.ToBase64String(inputBytes))
