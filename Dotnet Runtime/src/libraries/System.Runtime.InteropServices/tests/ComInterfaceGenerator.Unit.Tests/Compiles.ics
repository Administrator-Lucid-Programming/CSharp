        public static IEnumerable<object[]> ComInterfaceSnippetsToCompile()
            CodeSnippets codeSnippets = new(new GeneratedComInterfaceAttributeProvider())
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceType };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceTypeWithShadowingMethod };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceTypeShadowsNonComMethod };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceTypeShadowsComAndNonComMethod };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceTypeTwoLevelShadows};
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedWithParametersDeclaredInOtherNamespace };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ComInterfaceParameters };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ForwarderWithPreserveSigAndRefKind("ref") };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ForwarderWithPreserveSigAndRefKind("ref readonly") };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ForwarderWithPreserveSigAndRefKind("in") };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ForwarderWithPreserveSigAndRefKind("out") };
            raw csharp
                yield return new object[] { ID(), codeSnippets.ComInterfaceWithNativeMarshalling };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedComInterfaceTypeWithUnsafeBaseMethod };
            raw csharp
                yield return new object[] { ID(), codeSnippets.InterfaceWithProperties };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedInterfaceWithNewProperty };
            raw csharp
                yield return new object[] { ID(), codeSnippets.InterfaceWithDefaultImplementedMethod };
            raw csharp
                yield return new object[] { ID(), codeSnippets.InterfaceWithDefaultImplementedProperty };
            raw csharp
                yield return new object[] { ID(), codeSnippets.InterfaceWithIndexers };
            raw csharp
                yield return new object[] { ID(), codeSnippets.InterfaceWithRenamedIndexer };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedInterfaceWithNewIndexer };
            raw csharp
                yield return new object[] { ID(), codeSnippets.DerivedInterfaceWithNewRenamedIndexer };
            yield return new object[] { ID(), codeSnippets.InterfaceWithDefaultImplementedIndexer }

