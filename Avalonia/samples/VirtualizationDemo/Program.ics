using Avalonia

namespace VirtualizationDemo;

class Program
    raw csharp
        public static AppBuilder BuildAvaloniaApp()
            => AppBuilder.Configure<App>()
                .UsePlatformDetect()
        #if DEBUG
                .WithDeveloperTools()
        #endif
                .LogToTrace();

    public static int Main(string[] args)
        => BuildAvaloniaApp().StartWithClassicDesktopLifetime(args)
